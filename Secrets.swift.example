import Foundation

// Copy this file to `Sources/Secrets.swift` and fill in the values from your
// Google Cloud OAuth "Desktop" client (APIs & Services → Clients).
// `Sources/Secrets.swift` is gitignored on purpose.
enum Secrets {
    static let clientID = "YOUR_CLIENT_ID.apps.googleusercontent.com"
    static let clientSecret = "YOUR_CLIENT_SECRET"

    static let authURI = "https://accounts.google.com/o/oauth2/auth"
    static let tokenURI = "https://oauth2.googleapis.com/token"

    static let scope = "https://www.googleapis.com/auth/androidpublisher"
}
